[Unit]
Description=SEC//STATUS detection daemon
After=network.target

[Service]
ExecStart=/usr/local/bin/secstatus
Restart=always
RestartSec=3
RuntimeDirectory=secstatus
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StateDirectory=secstatus
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
